# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
# On Vercel, add each of these under Project Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Neon Postgres connection string.
# Use the POOLED connection string from the Neon dashboard — the host contains
# "-pooler" (e.g. ep-cool-name-123456-pooler.us-east-2.aws.neon.tech).
# `sslmode=require` is mandatory.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secret used by Auth.js to sign the session cookie / JWT.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"

# Canonical URL of the deployment. Auth.js infers this automatically on Vercel,
# so it is only needed locally (and for non-Vercel hosting).
AUTH_URL="http://localhost:3000"

# Trust the host header. Required on Vercel preview deployments, where the
# hostname changes on every push.
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# Seed script only — used by `npm run db:seed` to create the first staff login.
# These are NOT read at runtime.
#
# SET THESE ON VERCEL TOO. The deploy runs the seed, and if these are missing
# it falls back to admin@example.com / changeme123 — default credentials on a
# public URL. Choose a real email and a strong password.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="changeme123"
SEED_ADMIN_NAME="Fleet Admin"

# The seed never touches an account that already exists, so it is safe to run
# on every deploy. Set this to "true" for one deploy to overwrite the admin
# password with the current SEED_ADMIN_PASSWORD, then remove it again.
# SEED_ADMIN_RESET_PASSWORD="true"

# ---------------------------------------------------------------------------
# Business rules (optional — these are the defaults if unset).
# ---------------------------------------------------------------------------

# Free kilometres included per rental day.
NEXT_PUBLIC_FREE_KM_PER_DAY="200"

# Charge per kilometre driven beyond the free allowance, in dollars.
NEXT_PUBLIC_OVERAGE_RATE_PER_KM="1.00"

# ISO 4217 currency code used for display formatting.
NEXT_PUBLIC_CURRENCY="USD"
